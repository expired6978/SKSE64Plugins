#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_CAN

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SKEE_NATIVE_VERSION_MAJOR@,@SKEE_NATIVE_VERSION_MINOR@,@SKEE_NATIVE_VERSION_PATCH@,@SKEE_NATIVE_VERSION_TWEAK@
 PRODUCTVERSION @SKEE_NATIVE_VERSION_MAJOR@,@SKEE_NATIVE_VERSION_MINOR@,@SKEE_NATIVE_VERSION_PATCH@,@SKEE_NATIVE_VERSION_TWEAK@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "100904b0"
        BEGIN
            VALUE "FileDescription", "RaceMenu NG VR 2"
            VALUE "FileVersion", "@SKEE_NATIVE_PLUGIN_VERSION@"
            VALUE "InternalName", "skee64.dll"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "skee64.dll"
            VALUE "ProductName", "RaceMenu NG VR 2"
            VALUE "ProductVersion", "@SKEE_NATIVE_PLUGIN_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x1009, 1200
    END
END
