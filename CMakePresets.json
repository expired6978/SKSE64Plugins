{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-vcpkg-dynamic-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "$env{SKEE_BUILD_ROOT}/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "msvc-vcpkg-static-base",
      "hidden": true,
      "inherits": "msvc-vcpkg-dynamic-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "debug-msvc-vcpkg-ae",
      "inherits": "msvc-vcpkg-dynamic-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SKEE_GAME_RUNTIME": "AE"
      }
    },
    {
      "name": "release-msvc-vcpkg-ae",
      "inherits": "msvc-vcpkg-dynamic-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SKEE_GAME_RUNTIME": "AE"
      }
    },
    {
      "name": "debug-msvc-vcpkg-vr",
      "inherits": "msvc-vcpkg-dynamic-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SKEE_GAME_RUNTIME": "VR"
      }
    },
    {
      "name": "release-msvc-vcpkg-vr",
      "inherits": "msvc-vcpkg-dynamic-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SKEE_GAME_RUNTIME": "VR"
      }
    },
    {
      "name": "debug-msvc-vcpkg-static-ae",
      "inherits": "msvc-vcpkg-static-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SKEE_GAME_RUNTIME": "AE"
      }
    },
    {
      "name": "release-msvc-vcpkg-static-ae",
      "inherits": "msvc-vcpkg-static-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SKEE_GAME_RUNTIME": "AE"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-msvc-vcpkg-ae",
      "configurePreset": "debug-msvc-vcpkg-ae"
    },
    {
      "name": "release-msvc-vcpkg-ae",
      "configurePreset": "release-msvc-vcpkg-ae"
    },
    {
      "name": "debug-msvc-vcpkg-vr",
      "configurePreset": "debug-msvc-vcpkg-vr"
    },
    {
      "name": "release-msvc-vcpkg-vr",
      "configurePreset": "release-msvc-vcpkg-vr"
    },
    {
      "name": "debug-msvc-vcpkg-static-ae",
      "configurePreset": "debug-msvc-vcpkg-static-ae"
    },
    {
      "name": "release-msvc-vcpkg-static-ae",
      "configurePreset": "release-msvc-vcpkg-static-ae"
    }
  ]
}
