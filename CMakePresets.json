{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-vcpkg-flatrim-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "msvc-vcpkg-static-base",
      "hidden": true,
      "inherits": "msvc-vcpkg-flatrim-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "debug-msvc-vcpkg-flatrim",
      "inherits": "msvc-vcpkg-flatrim-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-msvc-vcpkg-flatrim",
      "inherits": "msvc-vcpkg-flatrim-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-msvc-vcpkg-static",
      "inherits": "msvc-vcpkg-static-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-msvc-vcpkg-static",
      "inherits": "msvc-vcpkg-static-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-msvc-vcpkg-flatrim",
      "configurePreset": "debug-msvc-vcpkg-flatrim"
    },
    {
      "name": "release-msvc-vcpkg-flatrim",
      "configurePreset": "release-msvc-vcpkg-flatrim"
    },
    {
      "name": "debug-msvc-vcpkg-static",
      "configurePreset": "debug-msvc-vcpkg-static"
    },
    {
      "name": "release-msvc-vcpkg-static",
      "configurePreset": "release-msvc-vcpkg-static"
    }
  ]
}
